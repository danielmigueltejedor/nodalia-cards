# Copy to `.env` next to docker-compose.yml and fill in real values.
# Never commit `.env` or real passwords/tokens.

# Public hostname (no scheme). Replace if your instance differs.
WEBLATE_SITE_DOMAIN=translate.getnodalia.com
WEBLATE_HTTP_PORT=8080

WEBLATE_ADMIN_NAME=Nodalia Admin
WEBLATE_ADMIN_EMAIL=admin@example.com
WEBLATE_ADMIN_PASSWORD=change-me-strong-password

POSTGRES_USER=weblate
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=weblate

# Optional email (recommended for invitations / password resets)
# WEBLATE_EMAIL_HOST=smtp.example.com
# WEBLATE_EMAIL_HOST_USER=
# WEBLATE_EMAIL_HOST_PASSWORD=
# WEBLATE_EMAIL_PORT=587
# WEBLATE_EMAIL_USE_TLS=1
# WEBLATE_SERVER_EMAIL=weblate@example.com
# WEBLATE_DEFAULT_FROM_EMAIL=weblate@example.com

# Optional: enable registration / social auth in the Weblate UI instead of
# hardcoding OAuth client secrets in this file when possible.
